new file mode 100644
index 0000000..19c4cf2
--- /dev/null
+++ b/src/common/caller.guard.ts
@@ -0,0 +1,14 @@
+import { CanActivate, ExecutionContext, Injectable, UnauthorizedException } from '@nestjs/common';
+import type { Request } from 'express';
+
+/** The caller is the X-User-Id header (the shop's auth stub until login lands): a positive integer, else 401. */
+@Injectable()
+export class CallerGuard implements CanActivate {
+  canActivate(ctx: ExecutionContext): boolean {
+    const req = ctx.switchToHttp().getRequest<Request & { callerId?: number }>();
+    const raw = req.header('x-user-id') ?? '';
+    if (!/^[1-9][0-9]{0,8}$/.test(raw)) throw new UnauthorizedException('X-User-Id must be a positive integer');
+    req.callerId = Number(raw);
+    return true;
+  }
+}
