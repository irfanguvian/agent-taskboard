diff --git a/src/users/users.service.spec.ts b/src/users/users.service.spec.ts
new file mode 100644
index 0000000..a6c1058
--- /dev/null
+++ b/src/users/users.service.spec.ts
@@ -0,0 +1,22 @@
+import { UsersService } from './users.service.js';
+
+describe('UsersService.list', () => {
+  it('returns each user with latestOrder from the same findMany, null without orders', async () => {
+    const order = { id: 7, totalMinor: 1234, status: 'paid', createdAt: new Date('2026-01-08T00:00:00Z') };
+    const calls: unknown[] = [];
+    const prisma = {
+      user: {
+        findMany: async (args: unknown) => {
+          calls.push(args);
+          return [
+            { id: 1, email: 'a@example.test', name: 'A', nickname: null, orders: [order] },
+            { id: 2, email: 'b@example.test', name: 'B', nickname: null, orders: [] },
+          ];
+        },
+      },
+    };
+    const page = await new UsersService(prisma as never).list({ limit: 20 });
+    expect(page.data.map((u) => (u as { latestOrder?: unknown }).latestOrder)).toEqual([order, null]);
+    expect(calls).toHaveLength(1);
+  });
+});
