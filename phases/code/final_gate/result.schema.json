{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings",
    "verdict_doc",
    "verification_doc",
    "summary"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "block"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "confidence",
          "where",
          "problem",
          "failure_scenario",
          "fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]{0,2}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRIT",
              "HIGH",
              "MED",
              "LOW"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "where": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(?!/)(?!(?:.*/)?\\.\\.(?:/|:))[^:\\u0000-\\u001f\\u007f\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060\\u2066-\\u2069\\ufeff]+:[1-9][0-9]{0,6}(?:-[1-9][0-9]{0,6})?$"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "failure_scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "cheap": {
            "type": "boolean"
          }
        }
      }
    },
    "verdict_doc": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^docs/verdicts/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}/){0,6}[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}\\.md$"
    },
    "verification_doc": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^docs/verification/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}/){0,6}[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}\\.md$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "worked_on",
        "blocker",
        "need_review",
        "verdict"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]+$"
        },
        "worked_on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "blocker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]+$"
        },
        "need_review": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]+$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "shipped",
            "partial",
            "blocked"
          ]
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "why",
          "options",
          "recommended"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "recommended": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    }
  }
}
