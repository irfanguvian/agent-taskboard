{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "cases",
    "report",
    "findings"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "kind",
          "source",
          "acceptance",
          "pre",
          "steps",
          "expect",
          "result",
          "recs",
          "screenshots",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-[1-9][0-9]{0,2}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "mixed"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "positive",
              "negative"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(?:A[1-9][0-9]{0,2}|(?!/)(?!(?:.*/)?\\.\\.(?:/|:))[^:\\u0000-\\u001f\\u007f\u061c\u200b-\u200f\u202a-\u202e\u2060\u2066-\u2069\ufeff]+:[1-9][0-9]{0,6}(?:-[1-9][0-9]{0,6})?)$"
          },
          "acceptance": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^A[1-9][0-9]{0,2}$"
            }
          },
          "pre": {
            "type": "string",
            "maxLength": 2048
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "expect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "ASSISTED",
              "BLOCKED"
            ]
          },
          "cause": {
            "type": "string",
            "enum": [
              "code",
              "test",
              "env"
            ]
          },
          "recs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}\\.[1-9][0-9]{0,3}$"
            }
          },
          "screenshots": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^docs/verification/screenshots/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}/){0,5}[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}\\.png$"
            }
          },
          "observed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "note"
            ],
            "properties": {
              "status": {
                "type": "integer"
              },
              "note": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^docs/verification/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}/){0,6}[A-Za-z0-9_-][A-Za-z0-9._-]{0,119}\\.md$"
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    }
  }
}
