{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "questions",
        "done"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "why",
          "options",
          "recommended"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "recommended": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "done_when_met": {
      "type": "boolean"
    },
    "commit_message": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
