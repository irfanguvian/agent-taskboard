#!/bin/bash -p
# The board's git bridge (board-terminal-parity Phase 2 task 5): lib/tbgit.js. A board run calls it by this full path,
# alone in its Bash call (sandbox.excludedCommands); anywhere else it refuses. Like bin/tb-chrome, node is the board's
# own: TB_NODE (tbd's process.execPath in the run env), never one found on PATH (security review L1); no PATH lookup here
# at all (the dir from BASH_SOURCE, builtins only).
set -u
unset NODE_OPTIONS NODE_PATH
here=$(cd "${BASH_SOURCE[0]%/*}" && pwd -P)
[ -x "${TB_NODE:-}" ] || { echo "tb-git: board runs only, with the git bridge on (no TB_NODE from the board)" >&2; exit 2; }
exec "$TB_NODE" "$here/../lib/tbgit-main.js" "$@"
