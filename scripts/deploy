#!/bin/sh
# Point the live worktree (~/taskboard-live) at a verified sha and restart tbd (D25).
# Usage: deploy <sha> [--no-restart] [--check] [--yes] [--force]    --check: validate only, change nothing
# Before the checkout, deploy-guard.js refuses while a flow is at work in review, qa or final_gate (C16, D-0091);
# --force deploys anyway (the guard still lists them).
# Rollback = deploy the previous sha (printed at the end, also in ~/.taskboard/deploy.log).
# Dev repo = the repo holding this script, or $TB_DEV.
set -eu
# shellcheck source=live-lib.sh
. "$(dirname "$0")/live-lib.sh"

main() {
  sha='' restart=1 check=0 force=''
  for a in "$@"; do
    case $a in
      --no-restart) restart=0 ;;
      --check) check=1 ;;
      --yes) ;;
      --force) force=--force ;;
      -*) die "unknown flag $a" ;;
      *) sha=$a ;;
    esac
  done
  [ -n "$sha" ] || die "usage: deploy <sha> [--no-restart] [--check] [--yes] [--force]"
  guard_home "$@"
  dev=${TB_DEV:-$(cd "$(dirname "$0")/.." && pwd)}
  full=$(git -C "$dev" rev-parse --verify --quiet "$sha^{commit}") || die "unknown commit: $sha"
  prev=none
  if [ -e "$LIVE" ]; then
    [ -z "$(git -C "$LIVE" status --porcelain)" ] || die "$LIVE has uncommitted changes; inspect it, then retry"
    prev=$(git -C "$LIVE" rev-parse HEAD)
  fi
  if [ "$check" = 1 ]; then
    # $LIVE was deleted by hand but git still lists it: a plain `worktree add` would refuse; the real run prunes first.
    live_abs=$(cd "$(dirname "$LIVE")" && pwd -P)/$(basename "$LIVE")
    [ -e "$LIVE" ] || ! git -C "$dev" worktree list --porcelain | grep -qxF "worktree $live_abs" || echo "deploy: $LIVE is registered but missing; a real deploy prunes it first" >&2
    exit 0
  fi

  TB_HOME=$TBHOME "$NODE" "$(dirname "$0")/deploy-guard.js" ${force:+"$force"} || die "refused by deploy-guard (see above)"
  if [ "$prev" = none ]; then
    git -C "$dev" worktree prune
    git -C "$dev" worktree add -q --detach "$LIVE" "$full"
  else
    git -C "$LIVE" checkout -q --detach "$full"
  fi
  mkdir -p "$TBHOME"
  (umask 077; echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $prev -> $full" >> "$TBHOME/deploy.log")
  chmod 600 "$TBHOME/deploy.log" # a log from an older deploy keeps its old mode otherwise
  # M5.4 C18: the pinned lavish renderer, lockfile + integrity, no install scripts (A03). A sha without it (rollback) skips;
  # a failed install never stops the deploy: Clarify still works in the board and tb answer (tb doctor shows the fail).
  if [ -f "$LIVE/tools/lavish/package-lock.json" ]; then
    # npm's #!/usr/bin/env node must find D30's node, not one from the caller's PATH; fetch capped (old tbd runs meanwhile)
    PATH="$(dirname "$NODE"):$PATH" "$(dirname "$NODE")/npm" ci --ignore-scripts --no-audit --no-fund --fetch-timeout=20000 --fetch-retries=1 \
      --prefix "$LIVE/tools/lavish" >/dev/null ||
      echo "deploy: lavish install failed; Clarify works in the board + tb answer (see tb doctor)" >&2
  fi
  # Chrome in runs: the pinned browser tools bin/tb-chrome runs (same way: lockfile, no scripts; a fail only turns runs'
  # browser checks off, tb-chrome says how to install)
  if [ -f "$LIVE/tools/chrome/package-lock.json" ]; then
    PATH="$(dirname "$NODE"):$PATH" "$(dirname "$NODE")/npm" ci --ignore-scripts --no-audit --no-fund --fetch-timeout=20000 --fetch-retries=1 \
      --prefix "$LIVE/tools/chrome" >/dev/null ||
      echo "deploy: browser tools install failed; runs have no browser checks until npm ci --ignore-scripts --prefix $LIVE/tools/chrome" >&2
  fi
  echo "deployed $full (was $prev)"
  [ "$prev" = none ] || echo "rollback: scripts/deploy $prev"
  [ "$restart" = 0 ] || launchctl kickstart -k "$DOMAIN/$LABEL"
}

# One line on purpose: this script can live in the tree it checks out, and sh reads a script as it runs.
main "$@"; exit
