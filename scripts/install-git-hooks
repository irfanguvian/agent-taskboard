#!/bin/sh
# Copy scripts/pre-push and scripts/reference-transaction (auto deploy, D-0242) into the hooks dir of the git repo in
# cwd. Re-run after editing either.
set -e
here=$(cd "$(dirname "$0")" && pwd)
hooks=$(git rev-parse --git-path hooks)
mkdir -p "$hooks"
for h in pre-push reference-transaction; do
  install -m 755 "$here/$h" "$hooks/$h"
  echo "installed $h -> $hooks/$h"
done
